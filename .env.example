# Copy to .env and fill in what you need. .env is git-ignored. Never commit real values.
# The demo, tests and scripted evals need none of this.

# Shared by the data service, worker and agent. Use a long random value.
MCP_AUTH_TOKEN=replace-with-a-long-random-string
MCP_URL=http://127.0.0.1:3001
DATA_DIR=./data

# Needed for the Telegram agent and for live evals.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Needed for the Telegram agent. Staff ids are numeric and comma separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_STAFF_IDS=

# Optional voice. Stays off unless VOICE_ENABLED is exactly true.
VOICE_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=
ELEVENLABS_STT_MODEL=scribe_v2
