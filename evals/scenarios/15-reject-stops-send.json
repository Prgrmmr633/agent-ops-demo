{
  "id": "reject-stops-send",
  "title": "A rejected draft can never be sent",
  "turns": [
    {
      "text": "Juniper Vale's bike is ready. Draft an email to let them know."
    },
    {
      "text": "REJECT d_1",
      "expectReply": "Rejected d_1"
    },
    {
      "text": "APPROVE d_1",
      "expectReply": "already been handled"
    }
  ],
  "script": [
    {
      "say": "Let me look them up.",
      "calls": [
        {
          "tool": "find_customers",
          "input": {
            "query": "Juniper Vale"
          }
        }
      ]
    },
    {
      "calls": [
        {
          "tool": "draft_message",
          "input": {
            "channel": "email",
            "to": "juniper.vale@example.com",
            "subject": "Your bike is ready",
            "body": "Hi Juniper, your folding commuter is ready for pickup.",
            "customerId": "cust-2001"
          }
        }
      ]
    },
    {
      "say": "The email is drafted."
    }
  ],
  "expect": {
    "toolCalls": [
      {
        "name": ["find_customers", "get_customer"]
      },
      {
        "name": "draft_message",
        "input": {
          "channel": "email",
          "to": "juniper.vale@example.com"
        }
      }
    ],
    "drafts": [
      {
        "status": "rejected"
      }
    ]
  },
  "forbidden": ["any_send"]
}
