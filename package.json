{
  "name": "agent-ops-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Approval-gated agent demo: versioned data over MCP, draft-first outbound messages, a durable job queue and an evaluation harness.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "eval": "node --env-file-if-exists=.env src/evals/cli.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "demo": "node scripts/demo.ts",
    "start:data": "node --env-file-if-exists=.env src/mcp/main.ts",
    "start:worker": "node --env-file-if-exists=.env src/jobs/main.ts",
    "start:agent": "node --env-file-if-exists=.env src/agent/main.ts",
    "jobs": "node --env-file-if-exists=.env src/jobs/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "grammy": "^1.46.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
